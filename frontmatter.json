{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.startCommand": "npx hexo server",
  "frontMatter.preview.host": "http://localhost:4000",
  "frontMatter.content.publicFolder": "source",
  "frontMatter.global.timezone": "Asia/Taipei",
  "frontMatter.taxonomy.dateFormat": "yyyy-MM-dd HH:mm:ss",
  "frontMatter.dashboard.openOnStart": true,
  "frontMatter.file.preserveCasing": true,
  "frontMatter.content.pageFolders": [
    {
      "title": "文章",
      "path": "[[workspace]]/source/_posts",
      "filePrefix": "{{date|yyyyMMdd}}-",
      "previewPath": "posts"
    },
    {
      "title": "草稿",
      "path": "[[workspace]]/source/_drafts",
      "filePrefix": "{{date|yyyyMMdd}}-",
      "previewPath": "posts"
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": "posts",
      "fields": [
        {
          "title": "標題",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "發文日期",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true,
          "dateFormat": "yyyy-MM-dd HH:mm:ss"
        },
        {
          "title": "更新日期",
          "name": "updated",
          "type": "datetime",
          "isModifiedDate": true,
          "dateFormat": "yyyy-MM-dd HH:mm:ss"
        },
        {
          "title": "分類",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "標籤",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "摘要（SEO 描述）",
          "name": "description",
          "type": "string"
        },
        {
          "title": "痞客邦原文章 ID",
          "name": "pixnet_basename",
          "type": "string",
          "hidden": true
        }
      ]
    }
  ],
  "frontMatter.taxonomy.categories": [
    "LabVIEW",
    "基礎教學",
    "進階應用",
    "模組與工具包",
    "參考與筆記",
    "量測與資料擷取",
    "DAQ 資料擷取",
    "影像處理",
    "其他量測軟體",
    "單晶片與嵌入式",
    "Arduino",
    "PIC / Microchip",
    "ESP32",
    "STM32 / ARM",
    "RTOS",
    "其他 MCU",
    "專題實作",
    "電路與 PCB 設計",
    "PCB Layout",
    "AI 輔助設計",
    "電子電路與元件",
    "Python",
    "App 與軟體開發",
    "Android / App",
    "桌面與 C/C++",
    "資料庫",
    "開發流程與工程",
    "AI 與邊緣運算",
    "AI 開發工具",
    "Jetson 邊緣 AI",
    "自動化工作流",
    "雜記",
    "科技新知與文章收集",
    "網站與電腦",
    "職涯與生活"
  ],
  "frontMatter.taxonomy.tags": []
}